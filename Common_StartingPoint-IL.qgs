        <constraint field="Layer2Intersect" desc="Chose a layer to show C-Section intersection with" exp="array_contains(&#xa;&#x9; array_cat( &#xa;&#x9;&#x9; array_foreach(&#xa;&#x9;&#x9;&#x9;@layers&#xa;&#x9;&#x9;&#x9;, layer_property( @element,'name') &#xa;&#x9;&#x9;),array_foreach(&#xa;&#x9;&#x9;&#x9;@layers&#xa;&#x9;&#x9;&#x9;,layer_property(@element,'id')&#xa;&#x9;&#x9;)&#xa;&#x9;)&#xa;&#x9;,&quot;Layer2Intersect&quot;&#xa;) or &quot;Layer2Intersect&quot; is NULL"/>
        <constraint field="LabelField" desc="Field containing labels or categories to show on cross section" exp="array_contains(C_GetFields(&quot;Layer2Intersect&quot;),&quot;LabelField&quot;)"/>
        <constraint field="ColorField" desc="Field containing color codes instead of category styling" exp="array_contains(C_GetFields(&quot;Layer2Intersect&quot;),&quot;ColorField&quot;)"/>
        <constraint field="Text" desc="" exp=""/>
        <constraint field="Num" desc="" exp=""/>
        <constraint field="CSection" desc="" exp=""/>
      </constraintExpressions>
