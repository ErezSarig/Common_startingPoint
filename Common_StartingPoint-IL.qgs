      <dataDefinedFieldProperties/>
      <widgets/>
      <previewExpression>COALESCE( "CSection", '&lt;NULL>' )</previewExpression>
      <mapTip enabled="1">&lt;style>
div {
    background:white;
    border-radius:5px;
    min-width: 500px;
    font-family: [% @Font %];}
	h1 { font-size:20px; text-align:center; letter-spacing:2.5px;font-weight:bold;}
	h2{ font-size:20px; text-align:center;} p { font-size:12px; text-align:center;} 
	.sub{ font-size:12px;font-weight:light; text-align:right;color:#968C8C;} 
	div.mapTip{min-height:300px;min-width:200px;overflow:scroll;border-radius:10px;}
	* {color:#968C8C;}
&lt;/style>
[% 
-- Y Axis from "CSection" field taken from @DEM layer

with_variable('Y' -- Generating variable to avoid possible re calculation of CSection
	,array_foreach(string_to_array("CSection"),to_real(@element))
	
	-- Creating the points for the graph in reference to the top Y value
	,with_variable('Points'
		,array_foreach(
			generate_series(0,@Segments) -- Number of points is segments +1
			,round(@element*($length/@Segments),1) ||','||
			(array_max(@Y) - array_get(@Y,@element))
		)
		,with_variable('MinMax'
			, array( string_to_array(array_get(@Points,array_find(@Y,array_min(@Y)))),string_to_array(array_get(@Points,array_find(@Y,array_max(@Y)))))
			,'
			&lt;h2> Length: '||round($length,1)||' | Elevation: '
			|| to_string(round((array_max(@Y)-array_min(@Y)),1)) || ' &lt;span style="font-weight:normal;font-size:0.8em">'||@project_distance_units|| '&lt;/h2>
			&lt;p>
			&lt;svg
				viewBox="0 -10 '|| (to_int($length) +2*@Margin) ||' '||to_int(eval(((@MinMax[0][1] - @MinMax[1][1])*@ZFactor)+30))||'" 
				width="98%"
				
				xmlns="http://www.w3.org/2000/svg"
				xmlns:xlink="http://www.w3.org/1999/xlink"
				version="1.0"
			>
			&lt;style>
				div {
					background:white;
					border-radius:5px;
					min-width: 600px;
				}
				* {color:#968C8C;}
				
				rect.inter {opacity:0.5; stroke:black; stroke-dasharray:0.5,1;}
				text.inter {font-family:'||@Font||';font-size: '|| to_string(max(3,300/$length)) ||'px;fill:black; stroke:black; stroke-width:0.0px;  }
				text.Distance {font-size: '|| to_string(max(2,50/$length)) ||'}
				text.MinMax {font-family:'||@Font||';font-size: '|| to_string(max(3,300/$length))||'}
			&lt;/style>
				'||
			-- Grid patterns for background #none,#smallGrid,#grid are optional
			
			'&lt;defs>'
				||
				-- inserting patterns for layer's categories
				coalesce(array_to_string(map_avals(C_GetCategories("Layer2Intersect",'Symbol')),' '),'')
				||
				'&lt;pattern y=15 id="smallGrid" width="10" height="10" patternUnits="userSpaceOnUse">
					&lt;path d="M 10 0 L 0 0 0 10" fill="transparent" stroke="dimgray" stroke-width="0.2"/>
				&lt;/pattern>
				&lt;pattern id="grid" width="50" height="50" patternTransform="translate('||@Margin||',15)" patternUnits="userSpaceOnUse">
					&lt;rect width="50" height="50" fill="url(#smallGrid)"/>
					&lt;path d="M 50 0 L 0 0 0 50 " fill="transparent" stroke="dimgray" stroke-width="0.5"/>
				&lt;/pattern>
				&lt;pattern id="none"/>
				&lt;filter id="f1">
					&lt;feDropShadow dx="1" dy="1" stdDeviation="1" flood-opacity="0.7"/>
				&lt;/filter>
				-- &lt;polygon id="triangle" x="0" y="0" points="0,10 5,0 10,10"  />
				&lt;circle id="circ" r="'||to_string(max(1.5,50/$length))||'" cx="0" cy="0" >
			&lt;/defs>'
			||
				-- Adding areas of intersections with CrossLayer on background
			'&lt;g id="Intersection" transform="translate('||@Margin||',0)">' ||
			if(layer_property("Layer2Intersect",'geometry_type') like '%Polygon'
				,array_to_string(array_foreach(
					overlay_intersects("Layer2Intersect",@feature)
					,with_variable('O'
						,with_variable('C'
							,coalesce(C_GetCategories("Layer2Intersect",'Label',@element),map('NoCat','NoCat'))
							,map(
								'Line',intersection($geometry,geometry(@element))
								,'Label',coalesce(attribute(@element,"LabelField"),map_avals(@C)[0])
								,'Color',coalesce(attribute(@element,"ColorField"),'url(#'|| map_akeys(@C)[0]||')')
							)
						),with_variable('Spaces'
							,array(
								to_int(max(0,(length(@O['Line']) - ((length(@O['Label'])+4)*to_int(@ChartFontSize))))/2) -- Calculated padding for Top Label
								,to_int(max(0,min(50,(length(@O['Line'])-(1+ length(to_string(to_int(length(@O['Line']))))*to_int(@ChartFontSize)))))) -- Claculated padding for ditance label
							)
							,concat(
								'&lt;g transform="translate('||round(line_locate_point($geometry,start_point(@O['Line'])),1)||',0)">' -- Moves the group to section starting point
								,'&lt;rect class="Inter" y="1" height="'||((@MinMax[0][1]*@ZFactor)+9)||'" width="' ||round(length(@O['Line']),1)||'" '
								,'fill="'||@O['Color'] ||'"/>'
								,'&lt;text class="Inter"  y="0" x="'||@Spaces[0]||'" lengthAdjust="spacingAndGlyphs" textLength="'|| to_int(length(@O['Line'])-(2* @Spaces[0])) ||'">'
								, @O['Label']
								,'&lt;/text>'
								,'&lt;text class="Distance" dy="1em" y="'||((@MinMax[0][1]*@ZFactor)+10)||'" x="'||@Spaces[1]||'" lengthAdjust="spacingAndGlyphs" textLength="'|| to_int(length(@O['Line'])-(2* @Spaces[1])) ||'"> '
								,round(length(@O['Line']),1) || ' ' ||  map_get(map('meters','m.','kilometers','km'),@map_units)
								,'&lt;/text>&lt;/g>'
							)
						)
					)
				),' ')
				,''
			)
			||'&lt;/g>'||
			'&lt;g class="Line" transform="scale(1,'||@ZFactor||')">
				&lt;rect  id="Frame"  y="0" x="'||@Margin||'" height="'||(@MinMax[0][1]+10/@ZFactor)||'" width="100%" fill="url('||@Grid||')" /> 
				&lt;g id="CSection" transform="translate('|| @Margin ||','||eval(5/@ZFactor)||')">
					&lt;polyline points="'||array_to_string(@Points,' ')||'"
						style="fill:none;stroke:black;stroke-width:'||(1.5/@ZFactor)||'"/>
				&lt;/g>
			&lt;/g>'||
			
			'&lt;g id="MaxPoint" filter="url(#f1)">
					&lt;use xlink:href="#circ" fill="'||@Color1||'" transform="translate('|| (@MinMax[1][0]+@Margin) ||','|| eval((@MinMax[1][1]*@ZFactor)+5) ||')" /> 
				&lt;/g>&lt;text class = "MinMax"
					x="'|| eval(@MinMax[1][0] +@Margin) ||'"
					y="'|| eval((@MinMax[1][1]*@ZFactor)+5) ||'" dy="-0.5em" style="letter-spacing:-0.5px" text-anchor="middle" 
				>'
				|| round(array_max(@Y),1)||' &lt;/text> 

			&lt;g id="MinPoint" filter="url(#f1)">
					&lt;use xlink:href="#circ"  fill="'||@Color2||'" transform="translate('|| (@MinMax[0][0]+@Margin) ||','|| (eval(@MinMax[0][1]*@ZFactor)+5) ||') rotate(180)" filter="url(#f1)" /> -- Rotation for triangle symbol
				&lt;/g>&lt;text class = "MinMax"
					x="'|| (@MinMax[0][0] +@Margin) ||'"
					y="'|| eval((@MinMax[0][1]*@ZFactor)+5)||'" dy="1.5em" style="letter-spacing:-0.5px" text-anchor="middle"
				>'
				|| round(array_min(@Y),1)||' &lt;/text> 
				
		&lt;/svg>'
		)
	)
) 
 %]
 &lt;br>
&lt;p style="text-align:left;margin:10px;"> Avg slope: &lt;b>% 
[% with_variable(
    'Y'
    ,array_foreach(string_to_array("CSection"),to_real(@element))
    ,round(array_sum(array_foreach(
        generate_series(0,array_length(@Y))
        ,abs(eval(array_get(@Y,@element+1)-array_get(@Y,@element)))/($length/(array_length(@Y)-1))
    ))/array_length(@Y)*100,1)
) %] &lt;/b> | ZFactor: &lt;b>[% @ZFactor %]
</mapTip>
    </maplayer>
