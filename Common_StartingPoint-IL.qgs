        <actionsetting isEnabledOnlyWhenEditable="0" type="1" capture="0" name="Export as SVG" action="from lxml import etree&#xa;from PyQt5.QtWidgets import QFileDialog&#xa;#from qgis.utils import iface&#xa;CaseSenitive = ['patternUnits','viewBox','stdDeviation', 'lengthAdjust','textLength', 'preserveAspectRatio','gradientUnits','gradientTransform','patternTransform','patternContentUnits']&#xa;Path =  QFileDialog().getSaveFileName(None,&quot;Save SVG:&quot;,'',&quot;SVG (*.svg)&quot;)[0]&#xa;FromMapTip = '''[%maptip(@feature)%]'''&#xa;with open(Path,'w') as f:&#xa;    parser = etree.XMLParser(recover=True)&#xa;    tree = etree.fromstring(FromMapTip, parser)&#xa;    svg_elements = tree.xpath(&quot;//svg&quot;)&#xa;    if svg_elements:&#xa;        svg_string = etree.tostring(svg_elements[0], encoding=&quot;unicode&quot;)&#xa;    for C in CaseSenitive:&#xa;        f.write(svg_string.replace(C.casefold(),C))" id="{f3f0cfd5-1168-44a6-b1b0-d77fedf5e816}" icon="" shortTitle="" notificationMessage="">
          <actionScope id="Feature"/>
