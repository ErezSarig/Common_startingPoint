        <field length="-1" type="10" precision="0" subType="0" comment="" typeName="text" name="Intersection" expression="-- Creates a json map of features in the intersected layer.&#xa;-- if &quot;GroupByField&quot; is not given grouping is done by layer's categories&#xa;-- ISum,IGeom an ICat fields are added to the features attributes&#xa;-- ISum counts the intersected area, length or units for polygons lines or points&#xa;-- IGoem is a wkt representation for the intersected geometry&#xa;-- ICat represents grouping category - either &quot;GroupByField&quot; value or feature's category&#xa;to_json(&#xa;&#x9;with_variable('IntersectedFeatures'&#xa;&#x9;&#x9;,overlay_intersects( &quot;Layer2Intersect&quot; &#xa;&#x9;&#x9;&#x9;,@feature&#xa;&#x9;&#x9;)&#xa;&#x9;&#x9;,array_foreach(@IntersectedFeatures&#xa;&#x9;&#x9;&#x9;,with_variable('G'&#xa;&#x9;&#x9;&#x9;&#x9;,intersection(geometry(@element),$geometry)&#xa;&#x9;&#x9;&#x9;&#x9;,map_concat(&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;attributes(@element)&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;,map(&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;'IGeom',geom_to_wkt(@G)&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;,'ICat',coalesce(&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;attribute(@element,&quot;GroupByField&quot;)&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;,map_akeys(C_GetCategories(&quot;Layer2Intersect&quot;,'Label',@element))[0]&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;)&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;,'ISum',round(CASE &#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN geometry_type(@G) = 'Polygon' THEN area(@G)&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN geometry_type(@G) = 'Line' THEN length(@G)&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN geometry_type(@G) = 'Point' THEN array_length(geometries_to_array(@G))&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;ELSE 0&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;END,2)&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;)&#xa;&#x9;&#x9;&#x9;&#x9;)&#xa;&#x9;&#x9;&#x9;)&#xa;&#x9;&#x9;)&#xa;&#x9;)&#xa;)"/>
      </expressionfields>
