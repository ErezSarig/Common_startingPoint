	border-radius:5px;
	min-height: 400px;
} { direction: rtl; font-family: [% @Font %];} h1 { font-size:20px; text-align:center; letter-spacing:2.5px;font-weight:bold;} h2{ font-size:20px; text-align:center;} p { font-size:12px; text-align:center;} .sub{ font-size:12px;font-weight:light; text-align:right;color:#968C8C;} div.mapTip{min-height:300px;min-width:200px;overflow:scroll;border-radius:10px;}
* {color:#968C8C;}

&lt;/style>
[%with_variable('Table'
	,C_Json2Sqlite2Json("Intersection"
		,with_variable('Fill'
			,if("GroupByField" is Null,'"url(#"||ICat||")"','"Auto"')
			,'SELECT '||coalesce("LabelField" ,'ICat')||' as Label,sum(ISum) as Size,'||@Fill||' as Color FROM data GROUP BY ICat;'
		)
	)
	,C_Plot(from_json(@Table)
		,@ChartType
		,if(@ChartType = 'Pie',120,50)
		,if("GroupByField" is Null
			,map_avals(C_GetCategories("Layer2Intersect",'Symbol',1,238))
			,array()
		)
	)
)%]</mapTip>
