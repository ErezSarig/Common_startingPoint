        <value>* { direction: rtl; font-family: [% @Font %];} h1 { font-size:20px; text-align:center; letter-spacing:2.5px;font-weight:bold;} h2{ font-size:20px; text-align:center;} p { font-size:12px; text-align:center;}  .sub{ font-size:12px;font-weight:light; text-align:right;color:dimgray;} h2 {display:inherit;} div.mapTip{min-height:300px;min-width:200px;overflow:scroll;border-radius:10px;}</value>
        <value>&lt;svg onload="init()" xmlns="http://www.w3.org/2000/svg"
aria-label="Calendar" role="img"
viewBox="0 0 512 512">
&lt;path d="M512 455c0 32-25 57-57 57H57c-32 0-57-25-57-57V128c0-31 25-57 57-57h398c32 0 57 26 57 57z" fill="#e0e7ec"/>
&lt;path d="M484 0h-47c2 4 4 9 4 14a28 28 0 1 1-53-14H124c3 4 4 9 4 14A28 28 0 1 1 75 0H28C13 0 0 13 0 28v157h512V28c0-15-13-28-28-28z" fill="#dd2f45"/>

&lt;g fill="#f3aab9">
  &lt;circle cx="470" cy="142" r="14"/>
  &lt;circle cx="470" cy="100" r="14"/>
  &lt;circle cx="427" cy="142" r="14"/>
  &lt;circle cx="427" cy="100" r="14"/>
  &lt;circle cx="384" cy="142" r="14"/>
  &lt;circle cx="384" cy="100" r="14"/>
&lt;/g>

&lt;text id="month"
  x="32" 
  y="164" 
  fill="#fff" 
  font-family="monospace"
  font-size="140px"
  style="text-anchor: left"> %1&lt;/text>

&lt;text id="day"
  x="256" 
  y="400" 
  fill="#66757f" 
  font-family="monospace"
  font-size="256px"
  style="text-anchor: middle"> %2 &lt;/text>

&lt;text id="weekday"
  x="256" 
  y="480" 
  fill="#66757f" 
  font-family="monospace"
  font-size="64px"
  style="text-anchor: middle"> %3 &lt;/text>
&lt;/svg></value>
        <value>with_variable( 'Att'
	,attributes()
	,
	-- Setting header 
	coalesce('&lt;h1 style="color:'||@Color1||';">' ||map_get(@Att,@HeaderField) ||'&lt;/h1>','')
	|| '&lt;table style="text-align:center; color:dimgray;">
		&lt;colgroup>
			&lt;col style="background-color:'||@Color2||'">
			&lt;col style="background-color:white;">
		&lt;/colgroup>'||
	-- Setting top fields
	if(coalesce(@TopFields,@LinkFields,'ERROR') &lt;> 'ERROR'
		,coalesce('&lt;thead>' || array_to_string(
				array_foreach(
					string_to_array(@LinkFields,',')
					,'&lt;tr>&lt;td colspan="2" style="color:black;">&lt;b>&lt;a href="' || map_get(@Att,@element) || '">'||C_GetAlias(@layer,@element)||'&lt;/a>&lt;/b>&lt;/td>&lt;/tr>'
				)
			),'')
		|| coalesce( array_to_string(
			array_foreach(
				string_to_array(@TopFields,',')
				,'&lt;tr>&lt;td style="color:black;">&lt;b>' || C_GetAlias(@layer,@element) || ': &lt;/b>&lt;/td>&lt;td>' || map_get(@Att,@element) ||'&lt;/td>&lt;/tr>'
			)
		),'')
		
		||'&lt;/thead>'
		,''
	) || '&lt;tbody class="sub" style="text-align:center;">'||
	-- Setting all other fields except images
	if(coalesce(@HideFields,'ERROR') &lt;> '*' 
		,with_variable('Hide'
			,string_to_array(concat(
				coalesce(@HeaderField||',','')
				,coalesce(@TopFields||',','')
				,coalesce(@ImageFields||',','')
				,coalesce(@LinkFields||',','')
				,coalesce(@HideFields,'')
			),',')
			,array_to_string(array_foreach( 
				map_akeys(@Att)
				,if(not array_contains(@Hide,@element)
					,'&lt;tr>&lt;td style="color:black;">' || C_GetAlias(@layer,@element) || ': &lt;/td>&lt;td>' 
					|| map_get(@Att,@element) ||'&lt;/td>&lt;/tr>'
					,''
				)
			),'')
		)
		,' '
	)
	||'&lt;/tbody>'||
	-- Adding images
	if( array_contains(map_akeys(@Att),array_get(string_to_array(@ImageFields),0))
		,'&lt;tfoot>' ||array_to_string(
			array_foreach(
				string_to_array(@ImageFields)
				,'&lt;br>&lt;b>'||@element||': &lt;/b>&lt;img src="'|| map_get(@Att,@element) ||'" alt="'||C_GetAlias(@layer,@element)||'">'
			)
			,' '
		) ||'&lt;/tfoot>'
		,''
	)
)||'&lt;/table>'</value>
        <value>Rubik</value>
        <value>&lt;svg xmlns="http://www.w3.org/2000/svg" width="200" height="200" viewBox="-65 -65 200 200">
  &lt;circle cx="0" cy="0" r="50" fill="param(fill) white" opacity="param(fill-opacity) 0.5"/>
  &lt;circle cx="0" cy="0" r="50" fill="transparent" stroke="black" stroke-width="5"/>
  &lt;line x1="-40" y1="-30" x2="40" y2="30" stroke="black" stroke-width="0.75" />
  &lt;line x1="-40" y1="30" x2="40" y2="-30" stroke="black" stroke-width="0.75" />
  &lt;g font-size="16px" font-family="rubik" fill="black">
    &lt;text x="0" y="-25" text-anchor="middle"> U &lt;/text>
