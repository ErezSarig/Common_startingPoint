    for F in ['C_GetVectLayer','C_GetFields','C_GetCategories','C_Plot','C_Json2Html','C_Json2Sqlite2Json','CVShed']: ## Removing C_methods ffrom QgsExpressions
        QgsExpression.unregisterFunction(F)
