        <actionsetting icon="" id="{915d3e96-13ee-4615-9be3-d1705acb8f34}" shortTitle="Export SVG" isEnabledOnlyWhenEditable="0" type="1" action="from bs4 import BeautifulSoup&#xa;from PyQt5.QtWidgets import QFileDialog&#xa;#from qgis.utils import iface&#xa;Path =  QFileDialog().getSaveFileName(None,&quot;Save SVG:&quot;,'',&quot;SVG (*.svg)&quot;)[0]&#xa;with open(Path,'w') as f:&#xa;    Soup = BeautifulSoup('''[%maptip()%]''', 'html.parser')&#xa;    ParentStyle = Soup.style.contents&#xa;    if ParentStyle != None:&#xa;        Soup.svg.style.insert(0,' '.join(ParentStyle))&#xa;    f.write(Soup.svg.prettify())" notificationMessage="" name="Save Chart as SVG" capture="0">
          <actionScope id="Feature"/>
