      <pythonCode type="QString">import qgis
from qgis.gui import *
from qgis.core import *
from qgis.utils import iface,qgsfunction
from qgis.PyQt.QtCore import QSize,QVariant
from osgeo import gdal,ogr,osr
gdal.UseExceptions()

#from qgis.core import QgsRenderContext, QgsReadWriteContext
#from qgis.PyQt.QtGui import QImage, QPainter, QColor
#import os
#import io
from tempfile import NamedTemporaryFile

import qgis
import math
import json
import sqlite3

from bs4 import BeautifulSoup,element
@qgsfunction(args='auto', group='Common')
def C_ServArea(Layer,BPoint,Radius ,Nodes,feature, parent):
    '''&lt;h2>C_ServArea(LayerId,BPoint,Radius ,Nodes,feature, parent&lt;/h2>
    &lt;b>Creating a service area (Network or boundary nodes) from a projects layer &lt;/b>&lt;br>
    LayerId :str, | LayerId from mapCanvas().Layers().id
    BPoint:QgsGeometry,  | Beginning point for network analysis
    Raius:int,  | Distance along network from BPoint
    Nodes:Bool  | False - Returns network as multipoliline geometr. True - Returns only external nodes to create service area using convex hull
    '''

    print('Recalculating')
    #Radius = 100
    Point = BPoint.asPoint()
    L= C_GetVectLayer(Layer)

    ## Minimizing repeating calculation
    #** setting a timer on HolonThings and check it. Make sure self is an option
    if not L.hasSpatialIndex():
        print('No index')
        L.dataProvider().createSpatialIndex()
    
    ## Getting only features in the radius ditance potenial
    Rect = QgsRectangle(Point,Point).buffered(Radius)
    GetRequest = QgsFeatureRequest(Rect)
    Features = L.getFeatures(GetRequest)

    FStore = QgsVectorLayer("MultiLineString?crs=ESPG:6991",'',"memory")
    for F in Features:
        FStore.dataProvider().addFeature(F)

    ## Setting all the network analysis builders,directors and strategies
    Director = QgsVectorLayerDirector(FStore, -1, '', '', '', QgsVectorLayerDirector.DirectionBoth)
    Strategy = QgsNetworkDistanceStrategy()
    Director.addStrategy(Strategy)
    Builder =QgsGraphBuilder(Layer.crs())
    TiedPoint = Director.makeGraph(Builder,[Point]) ## The Beginning point in the Graph
    Graph = Builder.graph()
    SourceID = Graph.findVertex(TiedPoint[0])
    
    ## Calculating the costs for the graph's tree
    (Tree, Costs) = QgsGraphAnalyzer.dijkstra(Graph,SourceID,0)
    del Layer ## reducing memory expences
    
    Geom = dict() ## to insert edges geometries before joining them
    for i in range(len(Tree)):
        if Tree[i] != -1:
            if Costs[i] &lt; Radius:
                if Nodes != True:
                    Edge = Graph.edge(Tree[i])
                    Point1 = Graph.vertex(Edge.fromVertex()).point()
                    Point2 = Graph.vertex(Edge.toVertex()).point()
                    
                    Geom[i] = QgsGeometry().fromPolylineXY([Point1,Point2])

            else:
                Delta = Costs[i] -Radius ## Expecting Possitive value 
                Edge = Graph.edge(Tree[i])
                Point1 = Graph.vertex(Edge.fromVertex()).point()
                Point2 = Graph.vertex(Edge.toVertex()).point()
                Distance = Point1.distance(Point2.x(),Point2.y())
                
                if (Distance - Delta) > 0: ## For edges not passing the radius
                    Ratio = Delta/Distance
                    X = Point2.x() - Point1.x()
                    Y = Point2.y() - Point1.y()
                    NewPoint = QgsPointXY(Point2.x()- (Ratio*X),(Point2.y()-Ratio*Y))
                    if Nodes == True:
                        Geom[i] = QgsGeometry().fromPointXY(NewPoint)
                    else:
                        Geom[i] = QgsGeometry().fromPolylineXY([Point1,NewPoint])

    return QgsGeometry().collectGeometry(list(Geom.values()))

def C_GetVectLayer(LayerName):
    if type(LayerName).__name__ == 'str':
            try:
                L = QgsProject.instance().mapLayersByName(LayerName)[0]
            except:
                L = iface.mapCanvas().layer(LayerName)
    elif type(LayerName) == qgis._core.QgsVectorLayer:
        L = LayerName
    else:
        raise ValueError("Expecting a vector layer")
        
    return L
    
@qgsfunction(args='auto', group='Common', referenced_columns=[])
def C_GetFields(LayerName,Alias=False,referenced_columns=[]):
    '''&lt;h2> C_GetFields(LayerName,Alias=False)&lt;/h2> &lt;b> Giving back a list of ther layer's fields&lt;/b>&lt;br>
    if Alias is True the function will return a list of field's aliases instean of filed names'''
    L= C_GetVectLayer(LayerName)
        
    if Alias:
        Names = dict()
        for F in L.fields():
            Names[F.name()] = F.alias()
    else:
        Names = [F.name() for F in L.fields()]
        
    return Names    
            
@qgsfunction(args='auto', group='Common', referenced_columns=[])   
def C_GetCategories(Layer,Property='Label',Feat=1,Size=60,referenced_columns=[]):
    '''&lt;h2> C_GetCategories(Layer,Property='Label',Feat=1,Size=60)&lt;/h2> &lt;b>Getting layer's categories data as a map object.&lt;/b>&lt;br>
    
    Layer : A layer object or a project's layer name &lt;br>
    Property : Label/Color/Symbol gets the relvant property of the category. Symbol gives back SVG pattern  only for fill symbols &lt;br>
    Feat : If a QgsFeature a map of the feature is given with the relevant category evaluated and return's a dictionary.  &lt;br>
    Size : Output svg size [width,height]
    '''
    L= C_GetVectLayer(Layer)
    R = L.renderer()
    Out = dict()
    if type(R) == qgis._core.QgsCategorizedSymbolRenderer:
        if type(Feat) == qgis._core.QgsFeature:
            Context = QgsExpressionContextUtils.createFeatureBasedContext(Feat,Feat.fields())
            Value = QgsExpression(R.classAttribute()).evaluate(Context)
            Cat = [R.categories()[R.categoryIndexForValue(Value)]]
        else:                
            Cat = R.categories()
            
        for C in Cat:
            ## Creating a dictionary with given categories paired to their labels and symbols (only fill symbols are shown)            
            if Property == 'Label':
                Out[str(C.value())] = C.label()
                
            elif Property == 'Color':
                Out[str(C.value())] = C.symbol().color()
                
            elif Property == 'Symbol':
                if C.symbol().type() == qgis.core.Qgis.SymbolType.Fill:
                    with NamedTemporaryFile() as F:
                        C.symbol().exportImage(F.name,'svg',QSize(Size,Size))
                        Soup = BeautifulSoup(F.read(), 'html.parser') ##Getting the SVG code
                        
                        ##Cleaning all irelevant tags and comments
                        Soup.title.decompose()
                        Soup.desc.decompose()
                        
                        for Line in Soup.contents:
                            if type(Line) == element.ProcessingInstruction or Line == '\n':
                                Soup.contents.remove(Line)
                            
                        ## Extracting the symbol's defs to be added as well
                        try:
                            Soup.defs.unwrap()
                        except:
                            pass
                            
                        Pattern_tag = Soup.new_tag('pattern' ,id=str(C.value()),x=Size/2,y=Size/2,width=Size,height=Size,patternUnits="userSpaceOnUse",stroke="transparent")
                        Soup.svg.wrap(Pattern_tag)
                        Soup.svg.unwrap()
                        
                        Out[str(C.value())] = Soup.prettify()
            else:
                raise ValueError("Expecting 'Label','Color' or 'Symbol' for Property")
            
            
        return Out
    else:
        raise ValueError("Expecting vector layer with categories")

@qgsfunction(args='auto', group='Common', referenced_columns=[])
def C_Plot(Data,Type='Pie',Dimensions=120,SvgPatterns=[],CSS='',UserScale=''):
    '''
    &lt;/h2> C_Plot(Data,Type='Pie',Dimensions=100,SvgPatterns=[],CSS='',UserScale='')&lt;/h2>
    &lt;h3> Ploting data to pie or bars charts. Returning svg code to embed where needed
    &lt;br>&lt;b>Data&lt;/b : JSON object using {"Size": int, "Color":str,"Label":str} like features. use "Color":'Auto' to use project's color scheme
    &lt;br>&lt;b>Type&lt;/b> : 'Pie'/'Bars' for matching displays
    &lt;br>&lt;b>Dimensions&lt;/b> : Radius size for pie charts and bar width for bar charts
    &lt;br>&lt;b>SvgPatterns&lt;/b> : A list of pattern to use for the svg defs section. Enables referncing instead of colors using 'url(#PatternName)'
    &lt;br>&lt;b>CSS&lt;/b> : Adding any style sheet defintions.
    &lt;br>&lt;b>UserScale&lt;/b> : Adding dimensions such as sqrt.
    &lt;br>&lt;sub>** Svg's ids named #Chart #Legend #PiePath&lt;Num> are reserved
    '''
    ##+ Add sum label option ('Abs'/'Per'/None) for showing each categorie's size in numbers
    try: ##Going through data to get general properties and check the features are constructed the right way
        Total = 0
        Top = Data[0]['Size']
        Bottom = 0
        for D in Data:
            if Top &lt; D['Size']:
                Top = D['Size']
            elif Bottom > D['Size']:
                Bottom = D['Size']
            Total += D['Size']

    except Exception as Err:
        raise ValueError(f"Expecting attribute named 'Size' with numeric values for all features.Got this error: ",Err)
        
    Colors = list(map(lambda C: C[0].name(),QgsProjectColorScheme().fetchColors()))
    ColorIndex = 0
    SvgParts= [f'&lt;Style>{CSS}&lt;/Style>','&lt;defs>','\n'.join(SvgPatterns),'&lt;/defs>']## Adding svg paterns, SVG openning tag will be added acording to chart type
    LegendParts =[]
    
    if Type.casefold() == 'Pie'.casefold():
        LineH =20 ##+Get font-size from CSS 
        HeightOfChart = Dimensions*2 +LineH
        VBox = ' '.join(list(map(str,[0,0,2*(Dimensions+LineH),HeightOfChart+(LineH*len(Data))]))) #- Size of chart plus legend
        SvgParts.insert(0,f'&lt;svg height="{HeightOfChart+(LineH*len(Data))}" ViewBox="{VBox}" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" version="1.1">')
        SvgParts.append(f'&lt;g id="Chart" transform="translate({Dimensions+LineH},{Dimensions+LineH})">')
        Start = 0 #Starting angle
        
        for i,D in enumerate(Data):
            if 'Color' in D.keys() and type(D['Color']) == str and 'Label' in D.keys() and type(D['Label']) == str:
                if D['Size'] &lt; 0:
                    raise ValueError(f"Pie charts aren't suppose to deal with negative values like the one given on feature number {i}")
                    
                if D['Color'].casefold() == 'Auto'.casefold():
                    D['Color'] = Colors[ColorIndex % len(Colors)] #Reycles the colors for lots of categories
                    ColorIndex +=1
                    
                Normal = Start + 360 * D['Size'] / Total #Normalized value
                x1 = Dimensions*round(math.cos(math.radians(Start)),2)
                y1 = Dimensions*round(math.sin(math.radians(Start)),2)
                x2 = Dimensions*round(math.cos(math.radians(Normal)),2)
                y2 = Dimensions*round(math.sin(math.radians(Normal)),2)
                Large_arc = 1 if Normal - Start > 180 else 0
                Path_d = f"M0,0 L{x1},{y1} A{Dimensions},{Dimensions} 0 {Large_arc},1 {x2},{y2} Z"
                LineW = min(round(D['Size']/Total* Dimensions*6.28),len(D['Label'])*20*4) #Avoiding to much lengthAdjustment
                SvgParts.append(f'''&lt;path id="PiePath{i}" d="{Path_d}" fill="{D['Color']}"/>''')
                #SvgParts.append(f'''&lt;text dy="-3px">&lt;textPath href="#PiePath{i}" lengthAdjust="spacingAndGlyphs" startOffset="{Dimensions}" textLength="{LineW}">{D['Label']}&lt;/textPath>&lt;/text>''')
                Start = Normal
                
                WritePretty = f"{D['Size']:,.2f}".rstrip('0').rstrip('.')
                LegendParts.append(f'''&lt;rect y="{i}em" height="1em" width="1em" fill="{D['Color']}"/> &lt;text x="1.5em" y="{i+1}em" font-size="1em" font-weight="bold">{D['Label']}&lt;tspan font-weight="normal" font-size="80%"> (סה״כ: {WritePretty} {UserScale})&lt;/tspan>&lt;/text> ''')

            else:
                raise ValueError("Data must be a json constructed from 'Size','Color' and 'Label' keys as strings even if empty")
        SvgParts.append('&lt;/g>')
            
    elif Type.casefold() == 'Bars'.casefold():
        X = 0
        Start= Top*240/(Top-Bottom)
        HeightOfChart = 260 if Bottom &lt; 0 else 240
        VBox = ' '.join(list(map(str,[0,0,(Dimensions+2)*len(Data),HeightOfChart + 20*len(Data) if Bottom &lt; 0 else (240+20*len(Data))]))) #- Size of chart plus legend ##Find line height instead of 20
        SvgParts.insert(0,f'&lt;svg ViewBox="{VBox}" height="{HeightOfChart + 20*len(Data)}" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" version="1.1">')
        for i,D in enumerate(Data):
            Normal = D['Size']*240/(Top -Bottom) #Normalizing values
            LineH =22*(abs(Normal)/Normal) #Depends on the bar's direction ##+Get font-size from CSS 
            if 'Color' in D.keys() and type(D['Color']) == str and 'Label' in D.keys() and type(D['Label']) == str:
                if D['Color'].casefold() == 'Auto'.casefold():
                    Colors[ColorIndex % len(Colors)] #Reycles the colors for lots of categories
                    ColorIndex +=1
                    
            SvgParts.append(f'''&lt;rect class="Polygons" x="{X}" y="{Start+LineH-max(Normal,0)}" width="{Dimensions}" height="{abs(Normal)}" fill="{D['Color']}"/>''')
            #SvgParts.append(f'''&lt;text class="Labels" font-size="20" x="{X}" y="{Start-Normal+LineH}" textLength="{Dimensions}" lengthAdjust="spacingAndGlyphs"> {D['Label']}&lt;/text>''')
            X += Dimensions + 2
            
            WritePretty = f"{D['Size']:,.2f}".rstrip('0').rstrip('.')
            LegendParts.append(f'''&lt;rect y="{i}em" height="1em" width="1em" fill="{D['Color']}"/> &lt;text x="1.5em" y="{i+1}em" font-size="1em" font-weight="bold">{D['Label']}&lt;tspan font-weight="normal" font-size="80%"> (סה״כ: {WritePretty} {UserScale})&lt;/tspan>&lt;/text> ''')

    else:
        raise ValueError("Expecting 'Bars' or 'Pie' on Type variable (2nd)")
    
    ##Adding legend
    LegendParts.insert(0,f'&lt;g id="Legend" transform="translate(0,{HeightOfChart})">') #Placing at bottom
    LegendParts.append('&lt;/g>')
    SvgParts.append('\n'.join(LegendParts))
    SvgParts.append('&lt;/svg>')
    return '\n'.join(SvgParts)
    
@qgsfunction(args='auto', group='Common', referenced_columns=[])
def C_VShed(DEMName,Point,Radius,Oz,Tz, EMode,Optimize,feature, parent):
    """
    Calculate a viewshed polygon with DEM, point and observer-target heights
    &lt;br>
    &lt;br>| DEMName (str)- DEM layer name or ID
    &lt;br>| Point (QgsGeometry) - represents the observer's location
    &lt;br>| Radius (int) - Radius for analysis
    &lt;br>| OH (real) - Observer height
    &lt;br>| TH (real) - Target height
    &lt;br>| EMode (str) Edge,Diagonal,Min,Max as options. '' or jibrish will get 'Edge'
    &lt;br>| Optimize (int) - Reduces DEM's resolution so that dataset pixel number is limited no matter what radius is chosen
    
    """
    ## Improve
    ## Make clipping faster
    O = Point.asPoint()
    
    ## Creating driver and data source for raster and vector layers
    Drive = ogr.GetDriverByName('Memory') 
    Data = Drive.CreateDataSource('Temp')
    #print(Data) ##^
    D = gdal.GetDriverByName('MEM')
    
    ## Getting DEM layer
    try:
        DEMUri = QgsProject.instance().mapLayersByName(DEMName)[0].dataProvider().dataSourceUri()
    except:
        DEMUri = iface.mapCanvas().layer(DEMName).dataProvider().dataSourceUri()
    #print(DEMUri) ##^
    DEM = gdal.Open(DEMUri,gdal.GA_ReadOnly)
    
    ## Preparing for new DEM creation for Optimization and Built options
    S = DEM.GetSpatialRef()
    T = DEM.GetGeoTransform()
    #print('T GeoTransform',T) ##^
    CellSize = T[1]
    
    Rect = QgsRectangle(O,O).buffered(Radius) ## Getting bounding box of the radius for clipping layers
    Extent = [Rect.xMinimum(),Rect.yMinimum(),Rect.xMaximum(),Rect.yMaximum()] ## Extent properties for future convinience
    #print('SRS',S) ##^
    
    ## Setting the wanted maximal cell size to check if DEM resolution needs change
    if Optimize != 0 :
        CellSize = max(Optimize,T[1])
    
    ## When changes to original DEM layer are needed (changing  clipping it before editting starts
    if T[1] &lt; CellSize:
        
        ## Setting the width and height by relevant cell size and extent
        if T[1] &lt; CellSize: ## Determining cell size by optimization
            XSize = math.ceil((Extent[2]-Extent[0])/CellSize)
            YSize = math.ceil((Extent[3]-Extent[1])/CellSize)
        else: ## Determining cell size by current
            XSize = math.ceil((Extent[2]-Extent[0])/T[1])
            YSize = math.ceil((Extent[3]-Extent[1])/abs(T[5]))
            CellSize = T[1]
        
        ## Creating a DEM in the relevant extent and resolution
        ClipDEM= D.Create('Clipped',XSize,YSize,1,gdal.GDT_Float32)
        ClipDEM.SetGeoTransform([Extent[0],CellSize,0,Extent[3],0,CellSize*(T[5])/abs(T[5])])
        ClipDEM.SetSpatialRef(S)
        
        gdal.Warp(ClipDEM, DEM,outputBounds= Extent,dstSRS=S,format='MEM',xRes=CellSize,yRes=CellSize)
        
        DEM = ClipDEM ## releasing the big DEM layer
    
    ## Setting the viewshed EMode
    if EMode == 'Max':
        E = gdal.GVM_Max
    elif EMode == 'Min':
        E = gdal.GVM_Min
    elif EMode == 'Diagonal':
        E = gdal.GVM_Diagonal
    else:
        E = gdal.GVM_Edge
        
    ## Optimizing for different gdal versions
    if int(gdal.__version__.split('.')[1]) &lt; 6:
        COption = None
    else:
        COption = ['None']
        
    V = gdal.ViewshedGenerate(
        DEM.GetRasterBand(1),
        'MEM',
        'V',
        observerX=O.x(),
        observerY=O.y(),
        observerHeight=Oz,
        targetHeight=Tz,  # targetHeight
        visibleVal=255,  # visibleVal
        invisibleVal=0,  # invisibleVal
        outOfRangeVal=1,  # outOfRangeVal
        noDataVal=-1,  # noDataVal,
        dfCurvCoeff=0.85714,  # dfCurvCoeff
        maxDistance=Radius,
        mode=E,
        heightMode=gdal.GVOT_NORMAL,
        creationOptions = COption
    )

    GLayer = Data.CreateLayer('VLayer',S,ogr.wkbPolygon)
    GLayer.CreateField(ogr.FieldDefn('Seen',ogr.OFTInteger))

    gdal.Polygonize(V.GetRasterBand(1),None,GLayer,0,[])
    #Data.ExecuteSQL("UPDATE VLayer SET geometry = ST_SimplifyVW(geometry,{})".format(CellSize))
    Vis = []
    for Feature in range(GLayer.GetFeatureCount()):
        if GLayer.GetFeature(Feature).GetField(0)== 255 :
            J = GLayer.GetFeature(Feature).ExportToJson()
            #^^ Improve by dropping the export and maybe simplify
            Vis.append(QgsJsonUtils.stringToFeatureList(J)[0].geometry().simplify(CellSize)) ## Get a qgs.geometry reprsentation
    
    Geom = QgsGeometry().unaryUnion(Vis)
    return Geom
    
@qgsfunction(group='Common', referenced_columns=[])
def C_Json2Sqlite2Json(json_str, query,Arr=False):
    ''' On the fly converting json string to sqlite performing a query and getting results back as json
    &lt;br>&lt;b> Json_str &lt;/b>(str) - Data for processing 
    &lt;br>&lt;b> Query &lt;/b>(str) - Query to process
    &lt;br>&lt;br> Data should be parsed like: &lt;br>
    [
    {"id": "1", "name": "Alice", "age": "30"},
    {"id": "2", "name": "Bob", "age": "25"},
    {"id": "3", "name": "Charlie", "age": "35"}
    ] 
    &lt;br> Query should use 'data' as the SQL Table (SELECT * FROM data)'''
    # Parse the JSON string into a Python dictionary/list
    try:
        data = json.loads(json_str)
    except Exception as Err:
        raise Exception('Json failed to load with this error: ',Err)
    
    # Create an in-memory SQLite database
    conn = sqlite3.connect(':memory:')
    cursor = conn.cursor()
    
    # Create a table dynamically based on the JSON structure (assuming it's a list of dictionaries)
    if isinstance(data, list) and isinstance(data[0], dict):
        columns = data[0].keys()
        #print(columns)
        columns_str = ', '.join([f'{col} TEXT' for col in columns])  # Assuming all columns are TEXT
        try:
            cursor.execute(f"CREATE TABLE data ({columns_str});")
        except Exception as Err:
            raise Exception('Table creation failed with this Err: ', Err, '| With this fields: ',columns_str)
        
        ErrRows = ''
        # Insert the data into the table
        for item in data:
            placeholders = ', '.join(['?' for _ in columns])
            values = tuple(item.values())
            
            try:
                cursor.execute(f"INSERT INTO data VALUES ({placeholders});", values)
            except Exception as Err:
                #raise Exception('Trying to insert these values:',' '.join([('|'+ str(x)) for x in values]), ' Got this error: ',Err) 
                ErrRows += str(item)+' \n '

    else:
        if not isinstance(data,list) :
            raise Exception('Data given is not sorted in a list')
        else:
            raise Exception('First line is not a dictionary, why?')
    # Commit the changes
    conn.commit()
    if len(ErrRows) > 0 :
        print('Rows that gone bad: ',ErrRows)
    # Execute the query
    cursor.execute(query)
    rows = cursor.fetchall()
    col_names = [description[0] for description in cursor.description]

    # Convert the query result into JSON format
    result = [dict(zip(col_names, row)) for row in rows]

    # Close the connection
    conn.close()

    # Return the result as a JSON string
    #print(result) ##^
    if Arr:
        return result
    else:
        return json.dumps(result)

@qgsfunction(args='auto',group='Common', referenced_columns=[])
def C_Json2Html(json_data, aliases=None, style="border: 1px solid black;"):
    # Parse the JSON string if it's a string; otherwise, assume it's already a dictionary or list
    if isinstance(json_data, str):
        data = json.loads(json_data)
    else:
        data = json_data
        
    # Set default aliases if none are provided
    if aliases is None:
        if isinstance(data, list) and len(data) >0:
            Sample= data[0]
        elif isinstance(data, dict):
            Sample = data
        aliases = dict()
        for k in Sample.keys():
            aliases[k] = k
    
    # Determine the order of columns based on the aliases (maintaining their order)
    column_order = list(aliases.keys())
    #print(column_order) #^^
    
    # Start building the HTML table with the custom style
    html = f'&lt;table style="{style}">\n'
    
    # If data is a list of dictionaries, create table headers from the keys
    if isinstance(data, list) and len(data) > 0 and isinstance(data[0], dict):
        #headers = data[0].keys()
        # Use aliases for the headers if provided, otherwise default to the original key
        html += '&lt;tr>' + ''.join([f'&lt;th>{aliases.get(header, header)}&lt;/th>' for header in column_order]) + '&lt;/tr>\n'
        
        # Add rows for each dictionary in the list
        for item in data:
            html += '&lt;tr>' + ''.join([f'&lt;td>{item[key]}&lt;/td>' for key in column_order]) + '&lt;/tr>\n'
    
    elif isinstance(data, dict) :  # If data is a single dictionary, create a 2-column table
        for key, value in data.items():
            html += f'&lt;tr>&lt;th>{aliases.get(key, key)}&lt;/th>&lt;td>{value}&lt;/td>&lt;/tr>\n'
    
    else:
        raise ValueError("Unsupported JSON format. Only lists of dictionaries or dictionaries are allowed.")
    
    # Close the table
    html += '&lt;/table>'
    
    return html

def openProject():
