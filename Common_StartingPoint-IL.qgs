        <actionsetting isEnabledOnlyWhenEditable="0" icon="" capture="0" id="{cbed99e6-6ffa-4fe2-a292-6f7f0c0f5fe8}" type="1" action="from bs4 import BeautifulSoup&#xa;from PyQt5.QtWidgets import QFileDialog&#xa;#from qgis.utils import iface&#xa;Path =  QFileDialog().getSaveFileName(None,&quot;Save SVG:&quot;,'',&quot;SVG (*.svg)&quot;)[0]&#xa;CaseSenitive = ['patternUnits','viewBox','stdDeviation', 'lengthAdjust','textLength', 'preserveAspectRatio','gradientUnits','gradientTransform','patternTransform','patternContentUnits']&#xa;FromMapTip = '''[%maptip(@feature)%]'''&#xa;print(FromMapTip)&#xa;Soup = BeautifulSoup(FromMapTip, 'lxml')&#xa;if Soup.svg:&#xa;    NotSensitive = str(Soup.svg)&#xa;    for C in CaseSenitive:&#xa;        NotSensitive=PrettyButNotSensitive.replace(C.casefold(),C)&#xa;        &#xa;    with open(Path,'w') as F:&#xa;        F.write(NotSensitive)&#xa;        F.close()&#xa;else:&#xa;    print('No svg was detected: \n', FromMapTip)&#xa;    " notificationMessage="" shortTitle="" name="ExportFile">
          <actionScope id="Canvas"/>
