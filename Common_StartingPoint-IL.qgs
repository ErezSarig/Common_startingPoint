        <field reuseLastValue="1" name="Layer2Intersect"/>
        <field reuseLastValue="0" name="Num"/>
        <field reuseLastValue="0" name="Text"/>
      </reuseLastValue>
      <dataDefinedFieldProperties/>
      <widgets/>
      <previewExpression>COALESCE( "CSection", '&lt;NULL>' )</previewExpression>
      <mapTip enabled="1">&lt;style>
div {
	background:white;
	border-radius:5px;
	min-width: 600px;
} { direction: rtl; font-family: [% @Font %];} h1 { font-size:20px; text-align:center; letter-spacing:2.5px;font-weight:bold;} h2{ font-size:20px; text-align:center;} p { font-size:12px; text-align:center;} .sub{ font-size:12px;font-weight:light; text-align:right;color:#968C8C;} div.mapTip{min-height:300px;min-width:200px;overflow:scroll;border-radius:10px;}
* {color:#968C8C;}

&lt;/style>
[% 
-- Y Axis from "CSection" field taken from @DEM layer
with_variable('Y'
	,array_foreach(
		string_to_array("CSection")
		,to_real(@element)
	)
	-- X axis by given length
	,with_variable('X'
		,generate_series(0,$length,(floor($length)/ (array_length(@Y)-1)))
		
		-- Creating the points for the graph in reference to the top Y value
		,with_variable('Points'
			,array_foreach(
				generate_series(0,array_length(@Y))
				,eval(array_get(@X,@element)) ||','||
				array_get(
					array_foreach(
						@Y
						,eval(array_max(@Y) - @element)
					)
					,@element
				)
			)
			-- Headings and SVG creation
			,'
			&lt;h2> Length: '||round($length,1)||' | Elevation: '
			|| to_string(round((array_max(@Y)-array_min(@Y)),1)) || ' &lt;span style="font-weight:normal;font-size:0.8em">'||@project_distance_units|| '&lt;/h2>
			&lt;p>
			&lt;svg
				viewbox="0 -10 '|| ($length +10) ||' '||eval(((array_max(@Y) - array_min(@Y))*@ZFactor)+40)||'"
				
				width="98%"
				style="align-self:center;border-style:solid;border-color:#926766;border-width:0.5;"
				xmlns="http://www.w3.org/2000/svg"
				xmlns:xlink="http://www.w3.org/1999/xlink"
				version="1.0"
			>
			&lt;style>
				rect.inter {opacity:0.5;height:100%; stroke:black; stroke-dasharray:0.5,1;}
				text.inter {font-family:'||@Font||';font-size: '|| to_string(max(2,300/$length)) ||'px;fill:black; stroke:black; stroke-width:0.0px;  }
				text.MinMax {font-family:'||@Font||';font-size: '|| to_string(max(3,300/$length))||'}
			&lt;/style>
				'||
			-- Grid patterns for background #none,#smallGrid,#grid are optional
			
			'&lt;defs>'
				||
				-- inserting patterns for layer's categories
				coalesce(array_to_string(map_avals(C_GetCategories("Layer2Intersect",'Symbol')),' '),'')
				||
				'&lt;pattern id="smallGrid" width="10" height="10" patternUnits="userSpaceOnUse">
					&lt;path d="M 10 0 L 0 0 0 10" fill="transparent" stroke="dimgray" stroke-width="0.2"/>
				&lt;/pattern>
				&lt;pattern id="grid" y="100%" width="50" height="50" patternUnits="userSpaceOnUse">
					&lt;rect width="50" height="50" fill="url(#smallGrid)"/>
					&lt;path d="M 50 0 L 0 0 0 50 " fill="transparent" stroke="dimgray" stroke-width="0.5"/>
				&lt;/pattern>
				&lt;pattern id="none"/>
				&lt;filter id="f1">
					&lt;feDropShadow dx="1" dy="1" stdDeviation="1" flood-opacity="0.7"/>
				&lt;/filter>
				&lt;polygon id="triangle" x="0" y="0" points="0,10 5,0 10,10"  />
				&lt;circle id="circ" r="3" cx="0" cy="0" >
			&lt;/defs>'
			||
				-- Adding areas of intersections with CrossLayer on background
			'&lt;g id="Intersection" transform="translate(5,0)">' ||
			if(layer_property("Layer2Intersect",'geometry_type') like '%Polygon'
				,array_to_string(array_foreach(
					overlay_intersects("Layer2Intersect",@feature)
					,with_variable('O'
						,with_variable('C'
							,coalesce(C_GetCategories("Layer2Intersect",'Label',@element),map('NoCat','NoCat'))
							,map(
								'Line',intersection($geometry,geometry(@element))
								,'Label',coalesce(attribute(@element,"LabelField"),map_avals(@C)[0])
								,'Color',coalesce(attribute(@element,"ColorField"),'url(#'|| map_akeys(@C)[0]||')')
							)
						)
						,concat(
							'&lt;rect class="Inter" y="0" x="'
							,round(line_locate_point($geometry,start_point(@O['Line'])),1)
							,'" width="'
							,round(length(@O['Line']),1)
							,'" fill="'
							,@O['Color']
							,'"/>'
							,'&lt;text class="Inter" dy="-2" lengthAdjust="spacingAndGlyphs" textLength="'
							,round(length(@O['Line']),1)
							,'" x="'
							,round(line_locate_point($geometry,start_point(@O['Line'])),1)
							,'">'
							,@O['Label']
							,'&lt;/text>'
						)
					)
				),' ')
				,''
			)
			||'&lt;/g>'||
			'&lt;g transform="scale(1,'||@ZFactor||')">
				&lt;rect  id="Frame" x="5" width="100%" height="100%" fill="url('||@Grid||')" />
				&lt;g id="CSection" transform="translate(5,'||eval(15/@ZFactor)||')">
					&lt;polyline points="'||array_to_string(@Points,' ')||'"
						style="fill:none;stroke:black;stroke-width:1.5"/>
				&lt;/g>
			&lt;/g>'||
			--Max value marker
			with_variable('Max'
				, string_to_array(array_get(@Points,array_find(@Y,array_max(@Y))))
				,'&lt;g id="MaxPoint" filter="url(#f1)">
					&lt;use xlink:href="#circ" fill="'||@Color1||'" transform="translate('|| (array_get(@Max,0)+5) ||','|| eval((array_get(@Max,1)*@ZFactor)+15) ||')" /> 
				&lt;/g>&lt;text class = "MinMax"
					x="'|| eval(array_get(@Max,0) +5) ||'"
					y="'|| eval((array_get(@Max,1)*@ZFactor)+15) ||'" dy="-0.2em" style="letter-spacing:-0.5px" text-anchor="middle" 
				>'
				|| round(array_max(@Y),1)||' &lt;/text> 
				'
			)|| 
			-- Min Value marker
			with_variable('Min'
				, string_to_array(array_get(@Points,array_find(@Y,array_min(@Y))))
				,'&lt;g id="MinPoint" filter="url(#f1)">
					&lt;use xlink:href="#circ"  fill="'||@Color2||'" transform="translate('|| (array_get(@Min,0)+10) ||','|| (eval(array_get(@Min,1)*@ZFactor)+15) ||') rotate(180)" filter="url(#f1)" />
				&lt;/g>&lt;text class = "MinMax"
					x="'|| array_get(@Min,0) ||'"
					y="'|| eval((array_get(@Min,1)*@ZFactor) +15)||'" dy="1em" style="letter-spacing:-0.5px" text-anchor="middle"
				>'
				|| round(array_min(@Y),1)||' &lt;/text> 
				'
				
			)||
			'&lt;/svg>'
		)
	)
)  %]
 &lt;br>
&lt;p style="text-align:left;margin:10px;"> Avg slope: &lt;b>% 
[% with_variable(
	'Y'
	,array_foreach(string_to_array("CSection"),to_real(@element))
	,round(array_sum(array_foreach(
		generate_series(0,array_length(@Y))
		,abs(eval(array_get(@Y,@element+1)-array_get(@Y,@element)))/($length/(array_length(@Y)-1))
	))/array_length(@Y)*100,1)
) %] &lt;/b> | ZFactor: &lt;b>[% @ZFactor %]
</mapTip>
