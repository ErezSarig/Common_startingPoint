      <constraintExpressions>
        <constraint desc="Choose a layer to show intersection area with your polygon" exp="array_contains(&#xa;&#x9; array_cat( &#xa;&#x9;&#x9; array_foreach(&#xa;&#x9;&#x9;&#x9;@layers&#xa;&#x9;&#x9;&#x9;, layer_property( @element,'name') &#xa;&#x9;&#x9;),array_foreach(&#xa;&#x9;&#x9;&#x9;@layers&#xa;&#x9;&#x9;&#x9;,layer_property(@element,'id')&#xa;&#x9;&#x9;)&#xa;&#x9;)&#xa;&#x9;,&quot;Layer2Intersect&quot;&#xa;) or &quot;Layer2Intersect&quot; is NULL" field="Layer2Intersect"/>
        <constraint desc="Field from intersected layer to group and sum the data with" exp="array_contains(&#xa;&#x9;C_GetFields(&quot;Layer2Intersect&quot;)&#xa;&#x9;,&quot;GroupByField&quot;&#xa;) or &quot;GroupByField&quot; is NULL" field="GroupByField"/>
        <constraint desc="" exp="" field="Text"/>
        <constraint desc="" exp="" field="Num"/>
        <constraint desc="" exp="" field="LabelField"/>
        <constraint desc="" exp="" field="Intersection"/>
      </constraintExpressions>
      <expressionfields>
        <field length="-1" name="Intersection" subType="0" expression="-- Creates a json map of features in the intersected layer.&#xa;-- if &quot;GroupByField&quot; is not given grouping is done by layer's categories&#xa;-- ISum,IGeom an ICat fields are added to the features attributes&#xa;-- ISum counts the intersected area, length or units for polygons lines or points&#xa;-- IGoem is a wkt representation for the intersected geometry&#xa;-- ICat represents grouping category - either &quot;GroupByField&quot; value or feature's category&#xa;to_json(&#xa;&#x9;with_variable('IntersectedFeatures'&#xa;&#x9;&#x9;,overlay_intersects( &quot;Layer2Intersect&quot; &#xa;&#x9;&#x9;&#x9;,@feature&#xa;&#x9;&#x9;)&#xa;&#x9;&#x9;,array_foreach(@IntersectedFeatures&#xa;&#x9;&#x9;&#x9;,with_variable('G'&#xa;&#x9;&#x9;&#x9;&#x9;,intersection(geometry(@element),$geometry)&#xa;&#x9;&#x9;&#x9;&#x9;,map_concat(&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;attributes(@element)&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;,map(&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;'IGeom',geom_to_wkt(@G)&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;,'ICat',coalesce(&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;attribute(@element,&quot;GroupByField&quot;)&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;,map_akeys(C_GetCategories(&quot;Layer2Intersect&quot;,'Label',@element))[0]&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;)&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;,'ISum',round(CASE &#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN geometry_type(@G) = 'Polygon' THEN area(@G)&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN geometry_type(@G) = 'Line' THEN length(@G)&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN geometry_type(@G) = 'Point' THEN array_length(geometries_to_array(@G))&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;ELSE 0&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;END,2)&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;)&#xa;&#x9;&#x9;&#x9;&#x9;)&#xa;&#x9;&#x9;&#x9;)&#xa;&#x9;&#x9;)&#xa;&#x9;)&#xa;)" comment="" typeName="text" type="10" precision="0"/>
      </expressionfields>
